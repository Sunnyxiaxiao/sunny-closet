# 复制本文件为 .env.local，然后在 .env.local 中填入真实值。
# .env.local 不会被提交到 git，请不要把真实密钥写进本文件。

# Supabase 项目地址（Project URL），形如 https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Publishable key（以 sb_publishable_ 开头），可以公开给浏览器
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Secret key（以 sb_secret_ 开头），只在服务端使用，绝不能泄露
SUPABASE_SECRET_KEY=

# 数据库连接地址（Session pooler），仅供 npm run db:setup 建表使用，网站运行时不需要。
# 形如 postgresql://postgres.xxxx:你的数据库密码@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
